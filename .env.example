# Copy this file to `.env` and fill in the values you need.
#
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real API keys.
# You can skip all of this and run the offline demo instead:
#
#   python run.py --provider mock


# --- Which backend to use: openai | gemini | mock ---
LLM_PROVIDER=openai

# --- OpenAI (needed when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (needed when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- Model behaviour ---
# Low temperature: extraction should be reproducible, not creative.
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=90

# --- Paths (relative paths resolve from the project root) ---
INPUT_DIR=data
OUTPUT_DIR=output

# --- Workflow ---
# Documents processed concurrently.
BATCH_WORKERS=4
# parallel = run the email and summary tasks side by side; sequential = one at a time.
TASK_MODE=parallel
# Documents longer than this are truncated to bound token cost.
MAX_DOCUMENT_CHARS=20000

# --- Logging: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO
